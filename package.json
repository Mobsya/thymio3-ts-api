    "run-demo": "tsup && npm run dev --prefix demo"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/web-bluetooth": "^0.0.21",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "rxjs": "^7.8.2"
  }
}
