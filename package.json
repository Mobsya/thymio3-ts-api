{
  "name": "thymio3-ts-api",
  "version": "0.2.0",
  "description": "Thymio 3 API",
  "thymio": {
    "firmwareCompatibility": {
      "min": "v1.8.0",
      "max": "v1.8.0"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup",
