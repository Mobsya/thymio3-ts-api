{
  "name": "thymio3-ts-api",
  "version": "0.3.1",
  "type": "module",
  "description": "Thymio 3 API",
  "thymio": {
    "firmwareCompatibility": {
      "min": "v1.8.0",
      "max": "v1.8.0"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "install-demo": "npm install --prefix demo",
    "build-demo": "tsdown && npm run build --prefix demo",
    "run-demo": "tsdown && npm run dev --prefix demo"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/web-bluetooth": "^0.0.21",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "rxjs": "^7.8.2"
  }
}
