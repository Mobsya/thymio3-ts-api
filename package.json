{
  "name": "thymio3-ts-api",
  "version": "0.4.0",
  "type": "module",
  "description": "Thymio 3 API",
  "thymio": {
    "firmwareCompatibility": {
      "min": "v1.8.0",
      "max": "v1.9.0"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "install-demo": "npm install --prefix demo",
    "build-demo": "tsc --noEmit && tsdown && npm run build --prefix demo",
    "run-demo": "tsc --noEmit && tsdown && npm run dev --prefix demo"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/web-bluetooth": "^0.0.21",
    "tsdown": "^0.22.13",
    "typescript": "^7.0.2"
  }
}
